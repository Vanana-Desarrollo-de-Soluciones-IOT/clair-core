# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/clair_core
DB_USERNAME=postgres
DB_PASSWORD=admin

# Resend Configuration
# For real sending, use your verified domain
# For testing delivery without sending real emails, use delivered@resend.dev
# For sandbox testing to your own email, use onboarding@resend.dev
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Email Provider: console or resend
EMAIL_PROVIDER=console

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_32_characters_long
JWT_EXPIRATION=3600000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
